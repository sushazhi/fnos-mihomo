#!/bin/bash
# Mihomo fnOS 应用 — 运行控制脚本
#
# 契约（飞牛官方 应用框架 文档）：
#   main start  → 启动服务，成功 0
#   main stop   → 停止服务，成功 0
#   main status → 运行中 0，未运行 3，出错 1
#
# 路径全部来自 TRIM_* 环境变量，不硬编码。

set -uo pipefail

APP_NAME="${TRIM_APPNAME:-mihomo}"
# 官方要求优先使用 TRIM_* 环境变量。这里 TRIM_* 缺失即视为异常环境（例如手工调试），
# 打印明确错误而不是猜测一个硬编码路径 —— 硬编码卷号是常见 bug 来源。
: "${TRIM_APPDEST:?TRIM_APPDEST 未设置（该脚本应由 fnOS 应用中心调用）}"
: "${TRIM_PKGVAR:?TRIM_PKGVAR 未设置（该脚本应由 fnOS 应用中心调用）}"
APP_DIR="${TRIM_APPDEST}"
DATA_DIR="${TRIM_PKGVAR}"
CONF_DIR="${TRIM_PKGETC:-${DATA_DIR}/etc}"

# 内核与面板资源：兼容 fnpack 打包布局与 target 子目录布局
res_path() {
    local rel="$1"
    for cand in "${APP_DIR}/${rel}" "${APP_DIR}/target/${rel}"; do
        if [ -e "${cand}" ]; then
            printf '%s' "${cand}"
            return 0
        fi
    done
    printf '%s' "${APP_DIR}/${rel}"
}

MIHOMO_BIN="$(res_path mihomo)"
UI_DIR="$(res_path ui)"

# 运行时配置（由 wizard/config_callback 写入 DATA_DIR/settings.env）
MIXED_PORT="${MIHOMO_MIXED_PORT:-7890}"
API_PORT="${MIHOMO_API_PORT:-9090}"
UI_PORT="${MIHOMO_UI_PORT:-9092}"
API_SECRET=""
SUB_URL=""
ALLOW_LAN="true"
# Cloudflare 优选 IP 穿透
CFOPT_URL=""
CFOPT_DOMAINS=""
CFOPT_INTERVAL="24"
# 优选来源：url = 外部优选结果（result.csv / 纯文本）；measure = 内置测速自己选
CFOPT_SOURCE="url"
# 内置测速参数：SNI 用于 TLS 测速、候选网段留空则用 Cloudflare 官方公布段
CFOPT_SNI="speed.cloudflare.com"
CFOPT_CIDRS=""
CFOPT_CANDIDATES="400"
CFOPT_CONC="48"
CFOPT_TIMEOUT_MS="1500"
CFOPT_SPEEDTEST="false"
if [ -f "${DATA_DIR}/settings.env" ]; then
    # shellcheck disable=SC1090
    . "${DATA_DIR}/settings.env" || true
    MIXED_PORT="${MIHOMO_MIXED_PORT:-$MIXED_PORT}"
    API_PORT="${MIHOMO_API_PORT:-$API_PORT}"
    UI_PORT="${MIHOMO_UI_PORT:-$UI_PORT}"
    API_SECRET="${MIHOMO_API_SECRET:-}"
    SUB_URL="${MIHOMO_SUBSCRIPTION_URL:-}"
    ALLOW_LAN="${MIHOMO_ALLOW_LAN:-true}"
    CFOPT_URL="${MIHOMO_CFOPT_URL:-}"
    CFOPT_DOMAINS_LEGACY="${MIHOMO_CFOPT_DOMAINS:-}"
    CFOPT_INTERVAL="${MIHOMO_CFOPT_INTERVAL:-24}"
    CFOPT_SOURCE="${MIHOMO_CFOPT_SOURCE:-url}"
    CFOPT_SNI="${MIHOMO_CFOPT_SNI:-speed.cloudflare.com}"
    CFOPT_CIDRS="${MIHOMO_CFOPT_CIDRS:-}"
    CFOPT_CANDIDATES="${MIHOMO_CFOPT_CANDIDATES:-400}"
    CFOPT_CONC="${MIHOMO_CFOPT_CONC:-48}"
    CFOPT_TIMEOUT_MS="${MIHOMO_CFOPT_TIMEOUT_MS:-1500}"
    CFOPT_SPEEDTEST="${MIHOMO_CFOPT_SPEEDTEST:-false}"
fi

# 域名清单改为**独立文件**（settings.env 里的旧字段仅用于一次性迁移）。
# 原因：向导 text 字段上限 1023 字节，而清单是数据（79 个域名已 929 字节）；
# 且表单提交是「整份替换」，浏览器自动填充的旧值会冲掉整份清单（真机踩过）。
CFOPT_DOMAINS_FILE="${DATA_DIR}/cfopt-domains.txt"
mkdir -p "${DATA_DIR}" 2>/dev/null || true
if [ ! -f "${CFOPT_DOMAINS_FILE}" ] && [ -n "${CFOPT_DOMAINS_LEGACY:-}" ]; then
    # 老版本升级路径：把 settings.env 里的清单落到文件，改一次即可，之后不再读该字段
    printf '%s\n' "${CFOPT_DOMAINS_LEGACY}" | tr ',' '\n' | sed '/^$/d' > "${CFOPT_DOMAINS_FILE}" 2>/dev/null \
        && log "cfopt: 已把 settings.env 里的域名清单迁移到 ${CFOPT_DOMAINS_FILE}" 2>/dev/null || true
fi
# 从文件读出清单（逗号拼接，供下游沿用原有参数形态）。`#` 注释与空行忽略。
# 只用 grep/tr/sed：`paste` 在部分精简环境里不存在（实测 MSYS 与某些容器就缺）。
CFOPT_DOMAINS="$(grep -vhE '^[[:space:]]*(#|$)' "${CFOPT_DOMAINS_FILE}" 2>/dev/null \
    | tr -d '[:blank:]' | tr '\n' ',' | sed 's/,$//' 2>/dev/null)"
CFOPT_DOMAINS="${CFOPT_DOMAINS:-}"

CONFIG_FILE="${DATA_DIR}/config.yaml"
LOG_FILE="${DATA_DIR}/mihomo.log"
CORE_PID="${DATA_DIR}/mihomo.pid"
UI_PID="${DATA_DIR}/ui.pid"
CFOPT_IP_FILE="${DATA_DIR}/cfopt-ips.txt"
CFOPT_SNIPPET="${DATA_DIR}/cfopt-hosts.txt"
CFOPT_PID="${DATA_DIR}/cfopt.pid"
CFOPT_HISTORY="${DATA_DIR}/cfopt-history.log"
# cfopt.py 的绝对路径：fetch / measure / inject 三个子命令都在这个文件里。
# 原先它们以 heredoc 内嵌在本脚本里 —— 行结构不可见、静态检查抓不到、无法单元测试。
CFOPT_PY="${APP_DIR}/cfopt.py"
# 「正在停止」标记：见 stop_all / cfopt_apply，用于挡住比守护进程活得久的刷新子进程
CFOPT_STOP_FLAG="${DATA_DIR}/cfopt.stop"
# 每个域名、每个协议族（IPv4 / IPv6）最多映射几个优选 IP。
# 注意：mihomo 的 ResolveIP 是在结果里【随机】取一个（DIRECT 双栈则按协议族并发竞速），
# 数量越多命中慢 IP 的概率越大，因此只保留前若干个（列表本身已按速度排序）。
CFOPT_TOP=4
# 按域名选 IP 时，每个域名保留几个（1 个最稳；留 2 个可在首选失效时兜底）。
# 用满 CFOPT_TOP(4) 没意义：实测同一 IP 对不同域名可差一个数量级，多塞只会增加
# 命中慢 IP 的概率。
CFOPT_MAP_TOP=2
# 注入行的自识别标记。**这是唯一的真源**：cfopt_inject 里的 python 直接读这个
# 环境变量（os.environ["CFOPT_MARK"]），不再各写一份字面量 —— 两处不一致会导致
# 历史注入的 rules 行永远剥不掉，每轮刷新多留一条过期 DIRECT 规则。
export CFOPT_MARK="# cfopt:"
# 内置测速的候选网段（Cloudflare 官方公布；见 https://www.cloudflare.com/ips-v4、ips-v6）
CFOPT_CIDRS_V4_DEFAULT="173.245.48.0/20,103.21.244.0/22,103.22.200.0/22,103.31.4.0/22,141.101.64.0/18,108.162.192.0/18,190.93.240.0/20,188.114.96.0/20,197.234.240.0/22,198.41.128.0/17,162.158.0.0/15,104.16.0.0/13,104.24.0.0/14,172.64.0.0/13,131.0.72.0/22"
CFOPT_CIDRS_V6_DEFAULT="2400:cb00::/32,2606:4700::/32,2803:f800::/32,2405:b500::/32,2405:8100::/32,2a06:98c0::/29,2c0f:f248::/32"

mkdir -p "${DATA_DIR}" 2>/dev/null || true

log() { echo "[$(date '+%F %T')] $*" >> "${LOG_FILE}" 2>/dev/null || true; }
fail() {
    # 官方约定：非零退出前把用户可见错误写入 TRIM_TEMP_LOGFILE
    echo "$*" >> "${TRIM_TEMP_LOGFILE:-/dev/null}" 2>/dev/null || true
    log "ERROR: $*"
    exit 1
}

# ── 订阅拉取：下载并强制修正关键字段 ────────────────────────
fetch_subscription() {
    [ -n "${SUB_URL}" ] || return 0
    [ -x /usr/bin/python3 ] || fail "缺少 python3，无法拉取订阅"

    log "fetching subscription"
    /usr/bin/python3 - "${SUB_URL}" "${CONFIG_FILE}" "${MIXED_PORT}" "${API_PORT}" "${ALLOW_LAN}" <<'PYEOF' >> "${LOG_FILE}" 2>&1
import re, sys, urllib.request

url, path, mixed, api, allow_lan = sys.argv[1:6]
try:
    req = urllib.request.Request(
        url, headers={"User-Agent": "clash.meta", "Accept": "application/yaml"}
    )
    with urllib.request.urlopen(req, timeout=40) as resp:
        data = resp.read().decode("utf-8", errors="replace")
except Exception as exc:                      # 网络失败保留旧配置
    print("fetch failed:", exc)
    sys.exit(1)

if not data.strip():
    print("empty subscription")
    sys.exit(1)

# 订阅里的端口/开关可能与 fnOS 应用设置冲突，这里以应用设置为准强制改写
def set_kv(text, key, value):
    pattern = r"(?m)^%s:.*$" % re.escape(key)
    if re.search(pattern, text):
        return re.sub(pattern, "%s: %s" % (key, value), text)
    return text.rstrip() + "\n%s: %s\n" % (key, value)

# ⚠️ 不要在 mixed-port 之外再保留 port / socks-port。
#    三者若指向同一端口，内核会先绑定 mixed-port，
#    随后的 "HTTP proxy" / "SOCKS server" 绑定必然失败：
#        level=error msg="Start SOCKS server error: listen tcp :7890: bind: address already in use"
#        level=error msg="Start Mixed(http+socks) server error: ... address already in use"
#    表现就是「HTTP 代理可用但 SOCKS5 被拒绝」，且日志明确报错。
#    mixed-port 本身已同时提供 HTTP + SOCKS5，故这里直接注释掉冗余项。
def disable_kv(text, key):
    pattern = r"(?m)^%s:.*$" % re.escape(key)
    if re.search(pattern, text):
        return re.sub(pattern, "# %s: (由 fnOS 应用托管，改用 mixed-port)" % key, text)
    return text

data = set_kv(data, "mixed-port", mixed)
data = disable_kv(data, "port")
data = disable_kv(data, "socks-port")
data = set_kv(data, "allow-lan", str(allow_lan).lower())
data = set_kv(data, "external-controller", "'0.0.0.0:%s'" % api)

with open(path, "w", encoding="utf-8") as handle:
    handle.write(data)
print("subscription written:", len(data), "bytes")
PYEOF
    # 订阅拉取失败不应阻塞启动（可能是临时断网）
    if [ -s "${CONFIG_FILE}" ]; then
        log "subscription ok"
    else
        log "subscription failed, keeping previous config"
    fi
}

# ── 首次启动生成最小可用配置 ────────────────────────────────
ensure_config() {
    [ -f "${CONFIG_FILE}" ] && return 0
    cat > "${CONFIG_FILE}" <<EOF
mixed-port: ${MIXED_PORT}
allow-lan: ${ALLOW_LAN}
bind-address: '*'
mode: rule
log-level: info
external-controller: '0.0.0.0:${API_PORT}'
secret: '${API_SECRET}'
proxies: []
proxy-groups:
  - name: PROXY
    type: select
    proxies: [DIRECT]
rules:
  - MATCH,DIRECT
EOF
    log "generated minimal config.yaml"
}

# geo 数据完整性校验。
#
# ⚠️ 只看文件大小是不够的：实测事故中随包的 geoip.metadb 是【被截断的下载结果】
#    （3366912 字节 vs 正确的 8389459 字节），大小检查形同虚设。
#    MMDB 的元数据标记 "MaxMind.com" 固定在文件尾部，截断文件必然缺失，
#    因此用标记而非大小判定，可靠且开销极低。
geodata_ok() {
    local file="$1" kind="$2" size first
    [ -s "${file}" ] || return 1
    case "${kind}" in
        geoip.metadb)
            # MMDB 元数据标记固定在文件尾部；截断文件必然缺失。
            grep -qa 'MaxMind.com' "${file}" 2>/dev/null || return 1
            ;;
        geosite.dat)
            # v2ray dat 是 protobuf，首字节应为 field 1 的 tag 0x0a。
            # 只查大小会把"截断到 1MB 以上"的坏文件判成好的，故加内容判据。
            size="$(stat -c %s "${file}" 2>/dev/null || echo 0)"
            [ "${size}" -gt 1000000 ] || return 1
            first="$(head -c 1 "${file}" 2>/dev/null | od -An -tu1 2>/dev/null | tr -d ' \n')"
            [ "${first}" = "10" ] || return 1
            ;;
    esac
    return 0
}

# 内核自带的下拉逻辑只认 GitHub Release 资产，而该域名在部分网络（含本机实测）
# 不可达，会一直挂到超时 —— 这正是"启动超时"的直接触发点。
# 因此这里主动用可达镜像（jsDelivr）补齐，内核就不会再去联网。
fetch_geodata() {
    local name="$1" dst url tmp
    dst="${DATA_DIR}/${name}"
    tmp="${dst}.part"
    for url in \
        "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/${name}" \
        "https://cdn.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/${name}" \
        "https://gcore.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/${name}"
    do
        # 超时必须显式给死：curl 默认无限等待，内核那次就是卡在这里。
        if curl -fL --retry 2 -m 120 -o "${tmp}" "${url}" 2>/dev/null && geodata_ok "${tmp}" "${name}"; then
            mv -f "${tmp}" "${dst}"
            log "fetched ${name} from mirror ($(stat -c %s "${dst}") 字节)"
            return 0
        fi
        rm -f "${tmp}" 2>/dev/null || true
    done
    log "WARN 无法从镜像获取 ${name}，内核可能因缺失 geo 数据启动失败"
    return 1
}

# 把随包的 geoip/geosite 复制到内核工作目录。
#
# ⚠️ 这一步不能省：内核以 `-d ${DATA_DIR}` 启动，会在【数据目录】里找
#    geoip.metadb / geosite.dat，而这两个文件随包安装在 ${APP_DIR}。
#    找不到时内核会尝试联网下载 —— 而此时代理还没起来，必然失败并卡住启动。
#    （实测：日志出现 "Can't find MMDB, start download" 后启动超时。）
seed_geodata() {
    local name src dst
    for name in geoip.metadb geosite.dat; do
        src=""
        for cand in "${APP_DIR}/${name}" "${APP_DIR}/target/${name}"; do
            [ -f "${cand}" ] && src="${cand}" && break
        done
        dst="${DATA_DIR}/${name}"

        # 目标已存在且完整 —— 无需处理。
        # 注意：即使随包副本损坏，只要数据目录里有一份【校验通过】的，
        # 也不要被损坏的随包副本覆盖（否则会从"能用"退回"不能启动"）。
        if geodata_ok "${dst}" "${name}"; then
            continue
        fi

        if [ -n "${src}" ] && geodata_ok "${src}" "${name}"; then
            cp -f "${src}" "${dst}" 2>/dev/null && log "seeded ${name} ($(stat -c %s "${dst}") 字节)"
            continue
        fi

        if [ -z "${src}" ]; then
            log "WARN ${name} 不在安装目录"
        else
            log "ERROR 随包 ${name} 校验失败（$(stat -c %s "${src}" 2>/dev/null) 字节），拒绝拷贝"
        fi
        # 随包副本不可用 → 走镜像补齐，避免内核自己去 GitHub 挂死
        fetch_geodata "${name}" || true
    done
}

write_secret() {
    [ -n "${API_SECRET}" ] || return 0
    /usr/bin/python3 - "${CONFIG_FILE}" "${API_SECRET}" <<'PYEOF' >> "${LOG_FILE}" 2>&1
import re, sys
path, secret = sys.argv[1], sys.argv[2]
text = open(path, encoding="utf-8").read()
pattern = r"(?m)^secret:.*$"
line = "secret: '%s'" % secret
text = re.sub(pattern, line, text) if re.search(pattern, text) else text.rstrip() + "\n" + line + "\n"
open(path, "w", encoding="utf-8").write(text)
PYEOF
}

# ── Cloudflare 优选 IP → DIRECT 出口 ─────────────────────────
#
# 要解决的问题：Cloudflare 免费版只把访客调度到「就近但不一定最快」的
# anycast IP，运营商绕路时延迟/丢包会明显变差。本功能把优选 IP 注入
# mihomo 的 hosts，于是走 DIRECT 出站的 CF 前置站点会直连到优选 IP。
#
# 优选来源有两种（CFOPT_SOURCE）：
#   url     —— 外部优选结果：result.csv（CloudflareSpeedTest）或纯文本 IP 列表；
#   measure —— 内置测速：从 Cloudflare 官方网段抽样，自己测 TCP 握手延迟，
#              可选再做一次带正确 SNI 的下载测速。两者产出同一份
#              CFOPT_IP_FILE，因此下游管线完全共用。
#
# 两种来源都【不是一次性】的：向导里保存只是一次初始值，真正保证
# 「优选一直有效」的是 cfopt_daemon 每 CFOPT_INTERVAL 小时反复重测/重拉，
# 每次拿到新结果再走同一条「注入 → 校验 → 换盘 → 热重载」。
#
# 生效链路（已逐条对照 mihomo 源码，不是推测）：
#   1. executor.ApplyConfig → updateHosts(cfg.Hosts) → resolver.DefaultHosts
#      （*trie.DomainTrie），【与 dns.enable 无关】，每次加载配置都会刷新；
#   2. resolver.LookupIPWithResolver / LookupIPv4/6WithResolver 在【任何 DNS
#      之前】先查 DefaultHosts，命中即返回；
#   3. DIRECT 出站拨号时 RemoteAddress() 仍是域名，经
#      dialer.WithResolver(resolver.DirectHostResolver) 走同一条链路；
#   4. 键 '+.example.com' 经 trie.Insert 同时写入【裸域精确命中】与
#      【子域通配】，因此一个键覆盖该域名及其所有子域；
#   5. rules 是首次匹配生效，所以注入的 DOMAIN-SUFFIX,...,DIRECT 必须
#      排在 rules 列表最前面。
#
# IPv4 / IPv6（这条是修正过的事实，别再按「内核一定关 IPv6」的老经验写）：
#   - Direct.DialContext 用 network="tcp"（Base.prefer = DualStack 时不加单栈约束），
#     dialer.parseAddr 因此调用 resolver.LookupIPWithResolver；
#   - 该函数命中 hosts 时是 `return node.IPs`，【完全不经过 DisableIPv6】，
#     所以同一个 hosts 键下的 IPv4 与 IPv6 会一起返回；
#   - 随后 dualStackDialContext 把 v4/v6 各成一组并发竞速（DualStack 下两组
#     都是 primary），先连上者胜 —— 即默认配置下 IPv6 优选天然可用；
#   - resolver.DisableIPv6 由【顶层】ipv6 驱动
#     （executor.updateGeneral: resolver.DisableIPv6 = !general.IPv6），
#     本应用生成的配置不写 ipv6，内核默认顶层 ipv6: true ⇒ DisableIPv6 = false；
#     只有订阅把顶层 ipv6 设为 false、且用 ip-version: ipv6-only 强制单栈
#     （network="tcp6" → LookupIPv6WithResolver）时才会被 ErrIPv6Disabled 拦掉；
#   - UDP/DIRECT 走 ResolveUDP → ResolveIPWithResolver，有 IPv4 时优先 IPv4。
#
# ⚠️ 使用前提（否则会「看起来没生效」）：
#   mihomo 只有在【拿到域名】时才能用 hosts 改写解析结果。
#   本应用以 package 用户运行、无法创建 TUN，因此：
#   - 浏览器/客户端把域名交给 mixed-port 代理（HTTP CONNECT / SOCKS 带域名）→ 生效；
#   - 应用自己解析 DNS 后按 IP 直连（不走代理端口）→ 内核根本看不到域名，hosts 无从介入。
#   后者请使用本功能同步生成的 cfopt-hosts.txt，粘贴到客户端 /etc/hosts
#   或局域网 DNS（AdGuard Home / dnsmasq）的 hosts 重写上。

# 拉取优选列表。解析成功才覆盖 CFOPT_IP_FILE，
# 网络抖动时沿用上一次的列表，避免把可用配置清空。
cfopt_fetch() {
    [ -n "${CFOPT_URL}" ] || return 1
    [ -x /usr/bin/python3 ] || { log "WARN cfopt: 缺少 python3"; return 1; }
    [ -f "${CFOPT_PY}" ] || { log "WARN cfopt: 缺少 ${CFOPT_PY}"; return 1; }
    /usr/bin/python3 "${CFOPT_PY}" fetch "${CFOPT_URL}" "${CFOPT_IP_FILE}" >> "${LOG_FILE}" 2>&1
}

# 内置测速：从 Cloudflare 官方网段抽样，自己测出优选 IP。
# 只用 Python 标准库，不需要额外二进制、不需要 root。
# 产出写到 CFOPT_IP_FILE，格式与 cfopt_fetch 完全一致，
# 因此「注入 → 校验 → 换盘 → 热重载」这条下游管线完全复用。
# 注意：测的是本机出口到 CF 的延迟/速度，而 DIRECT 出口也正是本机出口，
# 所以比在别处跑出来的第三方列表更贴近实际。
cfopt_measure() {
    [ -x /usr/bin/python3 ] || { log "WARN cfopt: 缺少 python3"; return 1; }
    [ -f "${CFOPT_PY}" ] || { log "WARN cfopt: 缺少 ${CFOPT_PY}"; return 1; }
    local cidrs="${CFOPT_CIDRS}"
    [ -n "${cidrs}" ] || cidrs="${CFOPT_CIDRS_V4_DEFAULT},${CFOPT_CIDRS_V6_DEFAULT}"
    /usr/bin/python3 "${CFOPT_PY}" measure "${cidrs}" "${CFOPT_IP_FILE}" "${CFOPT_SNI}" \
        "${CFOPT_CANDIDATES}" "${CFOPT_CONC}" "${CFOPT_TIMEOUT_MS}" \
        "${CFOPT_SPEEDTEST}" "${CFOPT_HISTORY}" "${CFOPT_TOP}" >> "${LOG_FILE}" 2>&1
}

# 按「优选来源」取数。两种来源产出同一份 CFOPT_IP_FILE。
cfopt_acquire() {
    case "${CFOPT_SOURCE}" in
        measure) cfopt_measure ;;
        *)       cfopt_fetch ;;
    esac
}

# 按域名分别实测，产出「域名 → 该域名最快的 IP」映射（CFOPT_IP_FILE.map）。
# 为什么需要：Cloudflare 的限速按「IP + 站点」计，同一 IP 对不同域名可差一个数量级，
# 一份全局 IP 列表必然让部分站点吃亏。失败不影响主流程 —— inject 会自动回退全局列表。
cfopt_map_domains() {
    [ -n "${CFOPT_DOMAINS}" ] || return 0
    [ -s "${CFOPT_IP_FILE}" ] || return 0
    [ -f "${CFOPT_PY}" ] || return 0
    /usr/bin/python3 "${CFOPT_PY}" map "${CFOPT_IP_FILE}" "${CFOPT_DOMAINS}" \
        "${CFOPT_IP_FILE}.map" "${CFOPT_MAP_TOP}" "${CFOPT_CONC}" >> "${LOG_FILE}" 2>&1 \
        || log "WARN cfopt: 按域名选 IP 失败，全部域名回退全局列表"
}

# 把优选 IP 注入配置副本：hosts 域名→IP 数组 + 置顶 DIRECT 规则。
# 注入的每一行都自带 '# cfopt:' 标记，重新注入时先整行剔除，
# 因此重复执行是幂等的，也不会随订阅更新不断堆积。
# 生成结果写到 ${CONFIG_FILE}.cfopt-new，原配置在通过校验前绝不改动。
cfopt_inject() {
    local doms="$1"
    [ -f "${CONFIG_FILE}" ] || return 1
    [ -x /usr/bin/python3 ] || return 1
    [ -f "${CFOPT_PY}" ] || return 1
    local cand="${CONFIG_FILE}.cfopt-new"
    cp -f "${CONFIG_FILE}" "${cand}" 2>/dev/null || return 1
    /usr/bin/python3 "${CFOPT_PY}" inject "${cand}" "${CFOPT_IP_FILE}" "${doms}" "${CFOPT_TOP}" "${CFOPT_SNIPPET}" >> "${LOG_FILE}" 2>&1
}

# 校验候选配置：mihomo -t 只做解析（executor.Parse → config.Parse），
# 不调用 ApplyConfig、不绑定任何端口，因此可以和正在运行的内核并存。
cfopt_validate() {
    local cand="$1"
    [ -x "${MIHOMO_BIN}" ] || return 0
    if command -v timeout >/dev/null 2>&1; then
        timeout 30 "${MIHOMO_BIN}" -t -d "${DATA_DIR}" -f "${cand}" >> "${LOG_FILE}" 2>&1
    else
        "${MIHOMO_BIN}" -t -d "${DATA_DIR}" -f "${cand}" >> "${LOG_FILE}" 2>&1
    fi
}

# 热重载：优先走 Clash API（payload 分支不校验路径，且解析失败会返回 400
# 并保留原配置），失败再退到 SIGHUP。
cfopt_reload() {
    core_running || return 0
    local body code
    body="{\"path\": \"${CONFIG_FILE}\"}"
    if [ -n "${API_SECRET}" ]; then
        code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 -X PUT \
            -H "Authorization: Bearer ${API_SECRET}" \
            -H 'Content-Type: application/json' -d "${body}" \
            "http://127.0.0.1:${API_PORT}/configs?force=true")"
    else
        code="$(curl -s -o /dev/null -w '%{http_code}' -m 8 -X PUT \
            -H 'Content-Type: application/json' -d "${body}" \
            "http://127.0.0.1:${API_PORT}/configs?force=true")"
    fi
    case "${code}" in
        200|204)
            log "cfopt: 内核已热重载配置"
            return 0
            ;;
    esac
    log "WARN cfopt: API 热重载返回 ${code:-无响应}，改用 SIGHUP"
    # 兜底发 SIGHUP 前必须确认这个 pid 真的属于本应用内核：
    # pid 文件中可能残留崩溃前写入的「已被系统复用」的 pid，
    # 直接 kill 会误伤无关进程（与 stop_all 中 ﻿pkill -f 的教训同源）。
    local pid exe target
    pid="$(read_pid "${CORE_PID}")"
    target="$(readlink -f "${MIHOMO_BIN}" 2>/dev/null || printf '%s' "${MIHOMO_BIN}")"
    exe="$(readlink -f "/proc/${pid}/exe" 2>/dev/null)"
    if [ -n "${pid}" ] && [ "${exe}" = "${target}" ] && kill -HUP "${pid}" 2>/dev/null; then
        log "cfopt: 已向内核 ${pid} 发送 SIGHUP"
        return 0
    fi
    log "ERROR cfopt: 热重载失败（配置已落盘，下次重启应用生效）"
    return 1
}

# 一次完整动作：拉取 → 注入 → 校验 → 换盘 → 热重载。
cfopt_apply() {
    local mode="${1:-full}"
    [ -f "${CONFIG_FILE}" ] || return 0
    [ -x /usr/bin/python3 ] || return 0
    # 这里必须**先记一条日志**再返回：cfopt-refresh 只调本函数，若缺 cfopt.py 就静默
    # return 0，用户看到的是「功能完全没生效、连日志都没有」，无从排查（CI 漏打包即如此）。
    [ -f "${CFOPT_PY}" ] || { log "WARN cfopt: 找不到 ${CFOPT_PY}，跳过优选注入"; return 0; }
    # 应用正在停止：绝不能再改配置。刷新子进程可能比守护进程活得久一点，
    # 标记直到下次 start 才清除（见 stop_all / start_core）。
    if [ -f "${CFOPT_STOP_FLAG}" ]; then
        log "cfopt: 应用正在停止，放弃本次注入"
        return 0
    fi

    # 是否启用：域名必填；url 来源还必须有地址，measure 来源自己就能产出。
    local doms="" enabled=0
    if [ -n "${CFOPT_DOMAINS}" ]; then
        case "${CFOPT_SOURCE}" in
            measure) enabled=1 ;;
            *)       [ -n "${CFOPT_URL}" ] && enabled=1 ;;
        esac
    fi

    if [ "${enabled}" = "1" ]; then
        doms="${CFOPT_DOMAINS}"
        if [ "${mode}" = "cached" ]; then
            # 启动早期只用手上已有的列表，不联网（内置测速可能耗十几秒）
            if [ ! -s "${CFOPT_IP_FILE}" ]; then
                log "cfopt: 暂无优选列表，留待启动后刷新补齐"
                return 0
            fi
        else
            cfopt_acquire || log "WARN cfopt: 取优选列表失败，沿用上次缓存的 IP 列表"
            if [ ! -s "${CFOPT_IP_FILE}" ]; then
                log "WARN cfopt: 没有可用的 IP 列表，跳过注入"
                return 0
            fi
        fi
    fi

    local cand="${CONFIG_FILE}.cfopt-new"
    # 注入前先按域名挑 IP（有映射的域名用自己实测最快的，其余**不注入**、保留订阅策略）。
    # ⚠️ cached 模式（启动早期、内核还没起）**不重测**：那一轮要给每个域名各做一次 TLS
    #    实测（实测 272 域名 ≈227s），等于把「代理可用」整体推迟好几分钟。启动时沿用上一轮
    #    留下的映射即可；map 自己有 TTL + 域名指纹，full 模式会按需重测，不会用陈旧结果。
    if [ "${mode}" != "cached" ]; then
        cfopt_map_domains || true
    fi
    if ! cfopt_inject "${doms}"; then
        rm -f "${cand}" 2>/dev/null || true
        log "ERROR cfopt: 生成注入配置失败"
        return 1
    fi

    # 内容没变就不必校验和重载，避免无意义地打断现有连接
    if cmp -s "${CONFIG_FILE}" "${cand}" 2>/dev/null; then
        rm -f "${cand}" 2>/dev/null || true
        return 0
    fi

    if ! cfopt_validate "${cand}"; then
        log "ERROR cfopt: 注入后的配置未通过校验，本次注入已放弃（原配置未被改动）"
        mv -f "${cand}" "${DATA_DIR}/cfopt-rejected.yaml" 2>/dev/null || rm -f "${cand}" 2>/dev/null || true
        return 1
    fi

    cp -f "${CONFIG_FILE}" "${CONFIG_FILE}.cfopt.bak" 2>/dev/null || true
    if ! mv -f "${cand}" "${CONFIG_FILE}"; then
        log "ERROR cfopt: 替换配置失败"
        return 1
    fi
    if [ "${enabled}" = "1" ] && grep -qF "${CFOPT_MARK}" "${CONFIG_FILE}" 2>/dev/null; then
        log "cfopt: 已注入优选 IP（来源：${CFOPT_SOURCE}，域名：${doms}）"
    elif [ "${enabled}" = "1" ]; then
        # 本次一个映射都没写成（hosts/rules 写法不支持被整次放弃），
        # 只是把上一轮的注入清理掉了 —— 别报「已注入」。
        log "cfopt: 本次未注入任何内容（写法不支持），已清理旧的优选注入"
    else
        log "cfopt: 已清除优选注入（功能未启用）"
    fi
    cfopt_reload
}

# 后台常驻：每 CFOPT_INTERVAL 小时刷新一次
cfopt_daemon() {
    local hours="${1:-24}" secs
    case "${hours}" in ''|*[!0-9]*) hours=24 ;; esac
    secs=$(( hours * 3600 ))
    log "cfopt: 刷新守护进程启动，间隔 ${hours}h"
    while :; do
        sleep "${secs}" &
        wait $! 2>/dev/null || break
        bash "${0}" cfopt-refresh >> "${LOG_FILE}" 2>&1 || true
    done
    log "cfopt: 刷新守护进程退出"
}

cfopt_loop_start() {
    # 先把上一轮的守护进程、以及可能正在前台跑的刷新子进程收干净，再决定是否启动。
    # 早先把这段放在间隔判断之后，导致「把间隔从 24 改成 0」时旧守护进程依然活着、
    # 继续按老间隔改配置 —— “仅启动注入一次”被静默忽略。
    local old
    old="$(read_pid "${CFOPT_PID}")"
    # 只杀【确认是本脚本守护进程】的那个 pid：pid 文件可能因崩溃而残留，
    # pid 复用时会误杀无关进程（cfopt_reload 里的 SIGHUP 也出于同样顾虑做了校验）。
    if cfopt_pid_is "${old}" cfopt-daemon; then
        kill -TERM "${old}" 2>/dev/null || true
        sleep 1
        cfopt_pid_is "${old}" cfopt-daemon && kill -KILL "${old}" 2>/dev/null || true
    elif [ -n "${old}" ] && pid_alive "${old}"; then
        log "cfopt: pid 文件里的 ${old} 不是本应用的刷新守护进程，只清文件不杀进程"
    fi
    rm -f "${CFOPT_PID}" 2>/dev/null || true
    cfopt_reap_children

    [ -n "${CFOPT_DOMAINS}" ] || { log "cfopt: 未配置域名，定时刷新未启动"; return 0; }
    if [ "${CFOPT_SOURCE}" = "measure" ]; then
        :                                    # 内置测速不需要外部地址
    elif [ -z "${CFOPT_URL}" ]; then
        log "cfopt: 未配置优选地址，定时刷新未启动"
        return 0
    fi

    local hours="${CFOPT_INTERVAL}"
    case "${hours}" in ''|*[!0-9]*) hours=24 ;; esac
    if [ "${hours}" -lt 1 ] || [ "${hours}" -gt 720 ]; then
        log "cfopt: 刷新间隔 ${hours}h，仅做启动时一次注入（已停掉旧的定时刷新）"
        return 0
    fi

    nohup bash "$(readlink -f "${0}" 2>/dev/null || printf '%s' "${0}")" \
        cfopt-daemon "${hours}" >> "${LOG_FILE}" 2>&1 &
    echo "$!" > "${CFOPT_PID}"
    log "cfopt: 定时刷新已启动，每 ${hours} 小时一次（pid $!）"
}

# 命令行是否指向本应用的这个脚本。除严格比对绝对路径外，还认「同名 <...>/cmd/<脚本名>」：
# 应用升级会换安装目录，旧守护进程命令行里仍是旧路径，不能因此漏杀 ——
# 漏杀会留下两个守护进程各自刷新（双份流量、双份 mihomo -t）。
cfopt_cmd_is_ours() {
    local cmd="${1:-}" self
    self="$(readlink -f "${0}" 2>/dev/null || printf '%s' "${0}")"
    case "${cmd}" in *"${self}"*) return 0 ;; esac
    case "${cmd}" in *"/cmd/${self##*/}"*) return 0 ;; esac
    return 1
}

# 判断 pid 是否确实是本脚本的某个子命令实例（防 pid 文件残留 + pid 复用误杀）。
# 没有 /proc、或读不到命令行时无从校验，退回「信任 pid 文件」的老行为 ——
# 宁可留下这点误杀风险，也不要漏杀，让两个守护进程同时改配置。
cfopt_pid_is() {
    local pid="${1:-}" want="${2:-}" cmd
    [ -n "${pid}" ] || return 1
    pid_alive "${pid}" || return 1
    [ -r "/proc/${pid}/cmdline" ] || return 0
    cmd="$( { tr '\0' ' ' < "/proc/${pid}/cmdline"; } 2>/dev/null )" || return 0
    cfopt_cmd_is_ours "${cmd}" || return 1
    case "${cmd}" in
        *"${want}"*) return 0 ;;
    esac
    return 1
}

# 收掉可能正在前台跑的刷新子进程。
# cfopt_daemon 每轮派生的 `bash <本脚本> cfopt-refresh` 是【独立进程】：
# 杀掉守护进程并不会连带杀掉它；而它一跑完就会把「本轮候选」mv 覆盖到
# config.yaml 上 —— 若此刻刚拉取了新订阅、或应用正在停止，就会把新配置盖回去。
cfopt_reap_children() {
    local pid cmd killed=0
    for p in /proc/[0-9]*; do
        pid="${p#/proc/}"
        [ "${pid}" = "$$" ] && continue
        [ "${pid}" = "${PPID}" ] && continue
        cmd="$( { tr '\0' ' ' < "${p}/cmdline"; } 2>/dev/null )" || continue
        case "${cmd}" in
            *cfopt-refresh*) ;;
            *) continue ;;
        esac
        # 还要确认是本应用的脚本，避免误伤命令行里恰好含该词的无关进程
        cfopt_cmd_is_ours "${cmd}" || continue
        if kill -KILL "${pid}" 2>/dev/null; then
            killed=$((killed + 1))
            log "reaped cfopt refresh child pid ${pid}"
        fi
    done
    return 0
}

pid_alive() {
    [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null
}

read_pid() {
    [ -f "$1" ] && head -n 1 "$1" | tr -d '[:space:]'
}

# Clash API 健康检查。
# ⚠️ 配置了 secret 时 Clash API 会返回 401，因此必须带上 Authorization，
# 否则健康检查永远失败（会把正常启动误判为超时）。
api_alive() {
    if [ -n "${API_SECRET}" ]; then
        curl -sf -m 2 -H "Authorization: Bearer ${API_SECRET}" \
            "http://127.0.0.1:${API_PORT}/version" >/dev/null 2>&1
    else
        curl -sf -m 2 "http://127.0.0.1:${API_PORT}/version" >/dev/null 2>&1
    fi
}

core_running() {
    local pid
    pid="$(read_pid "${CORE_PID}")"
    if pid_alive "${pid}"; then return 0; fi
    # 兜底：API 已响应也视为运行中
    api_alive
}

# 端口被「本应用之外」的进程占用时给出可读错误并退出。
# 注意：这里只检测、不 kill —— 无条件 fuser -k 会误杀用户的其它服务
# （实证教训，见 research/verify-network.md 对 mihomo-core 的审查）。
port_in_use_by_others() {
    local port="$1" pid=""
    command -v ss >/dev/null 2>&1 || return 1
    pid="$(ss -lntp 2>/dev/null | awk -v p=":${port}" '$4 ~ p"$" {print $NF}' \
           | grep -oE 'pid=[0-9]+' | head -1 | cut -d= -f2)"
    [ -n "${pid}" ] || return 1
    # 属于本应用目录的进程不算冲突
    if tr '\0' ' ' < "/proc/${pid}/cmdline" 2>/dev/null | grep -q "${APP_DIR}"; then
        return 1
    fi
    return 0
}

ui_running() {
    local pid
    pid="$(read_pid "${UI_PID}")"
    if pid_alive "${pid}"; then return 0; fi
    curl -sf -m 2 "http://127.0.0.1:${UI_PORT}/" >/dev/null 2>&1
}

start_core() {
    # 本次启动的开始：先清掉上一轮留下的「正在停止」标记。
    # 必须放在 core_running 早退【之前】—— 否则「内核还在运行时就 start」
    # 这条路径永远不会清标记，之后每次 start / refresh 都会被 cfopt_apply
    # 拒绝，功能被永久静默禁用（要等一次「内核确实不在」的 stop+start 才恢复）。
    rm -f "${CFOPT_STOP_FLAG}" 2>/dev/null || true
    if core_running; then
        log "core already running"
        return 0
    fi

    # 端口冲突预检：被其它程序的进程占用时直接报错，不抢占、不误杀
    if port_in_use_by_others "${MIXED_PORT}"; then
        fail "端口 ${MIXED_PORT} 已被其它程序占用，请在应用设置中改用其它端口。"
    fi
    if port_in_use_by_others "${API_PORT}"; then
        fail "端口 ${API_PORT} 已被其它程序占用，请在应用设置中改用其它端口。"
    fi

    seed_geodata          # 必须先于内核启动，否则会联网下载 geo 数据而超时
    ensure_config
    fetch_subscription
    write_secret
    # 订阅会整份覆盖 config.yaml，因此优选注入必须排在订阅之后、内核启动之前：
    # 这样内核一起来就带着 hosts + 置顶 DIRECT 规则，无需依赖热重载。
    # 这里用 cached：只用已有列表，不联网，避免内置测速把开机拖慢十几秒。
    cfopt_apply cached || log "WARN cfopt: 启动时注入优选 IP 失败，继续使用原配置"

    log "starting mihomo: ${MIHOMO_BIN} -d ${DATA_DIR}"
    nohup "${MIHOMO_BIN}" -d "${DATA_DIR}" -f "${CONFIG_FILE}" >> "${LOG_FILE}" 2>&1 &
    echo "$!" > "${CORE_PID}"

    local i
    for i in $(seq 1 20); do
        if api_alive; then
            log "core ready after ${i}s"
            return 0
        fi
        sleep 1
    done

    # 超时了：把内核自己报的错捞出来，别让用户只看到笼统的"启动超时"。
    # 实测最有价值的失败原因（geo 缺失 / 端口占用 / 配置错误）都在这里。
    local reason
    reason="$(grep -aE 'level=(error|fatal)' "${LOG_FILE}" 2>/dev/null | tail -3)"
    if [ -n "${reason}" ]; then
        fail "Mihomo 内核启动超时。内核报告：${reason}"
    fi
    fail "Mihomo 内核启动超时，请查看日志：${LOG_FILE}"
}

start_ui() {
    if ui_running; then
        log "ui already running"
        return 0
    fi
    [ -d "${UI_DIR}" ] || { log "no ui dir, skipping"; return 0; }

    # 统一网关通道：Socket 必须位于 TRIM_APPDEST（官方要求），
    # 与 app/ui/config 的 gatewaySocket 对应。
    # 启动前清理陈旧 Socket，否则 bind 会失败。
    local gw_socket="${APP_DIR}/app.sock"
    local gw_prefix="/app/${APP_NAME}"
    # 本应用注册了两个网关入口（主入口 + 状态页），共用同一 Socket。
    # 服务端按最长前缀优先剥离，这里从长到短列出便于阅读。
    local gw_prefixes="/app/${APP_NAME}/status,/app/${APP_NAME}"
    rm -f "${gw_socket}" 2>/dev/null || true

    # 面板静态文件目录（构建时下载到 target/panels）
    local panels_dir=""
    for cand in "${APP_DIR}/panels" "${APP_DIR}/target/panels"; do
        [ -d "${cand}" ] && panels_dir="${cand}" && break
    done

    # MIHOMO_DATA_DIR 必须传：状态页要从中读取 settings.env 的 API 密钥，
    # 否则对 Clash API 的请求会 401，状态页永远显示「离线」。
    MIHOMO_UI_PORT="${UI_PORT}" MIHOMO_API_PORT="${API_PORT}" \
    MIHOMO_UI_ROOT="${UI_DIR}" MIHOMO_LOG_FILE="${LOG_FILE}" \
    MIHOMO_DATA_DIR="${DATA_DIR}" \
    MIHOMO_SOCKET="${gw_socket}" \
    MIHOMO_GATEWAY_PREFIXES="${gw_prefixes}" \
    MIHOMO_PANELS_DIR="${panels_dir}" \
        nohup /usr/bin/python3 "${APP_DIR}/ui_server.py" >> "${LOG_FILE}" 2>&1 &
    echo "$!" > "${UI_PID}"

    # 就绪判定：状态页默认只开网关 Socket（不监听 TCP）。
    # 用 --unix-socket 请求一次，确认服务真的在响应。
    local i
    for i in $(seq 1 10); do
        if [ -S "${gw_socket}" ] && \
           curl -sf -m 2 --unix-socket "${gw_socket}" \
                "http://localhost${gw_prefix}/" >/dev/null 2>&1; then
            log "ui ready after ${i}s (gateway socket)"
            return 0
        fi
        sleep 1
    done
    log "ui health check timed out"
    return 0
}

stop_all() {
    local pid
    # 立「正在停止」标记：万一还有刷新子进程没被收掉，它完成时会看到这个标记
    # 而放弃覆盖配置。清除动作放在 start_core（而不是这里），否则停止过程中
    # 仍可能被它覆盖。
    : > "${CFOPT_STOP_FLAG}" 2>/dev/null || true
    # 刷新守护进程排在最前：先停它，否则它可能在停止过程中又把配置改回去
    for pf in "${CFOPT_PID}" "${UI_PID}" "${CORE_PID}"; do
        pid="$(read_pid "${pf}")"
        if pid_alive "${pid}"; then
            kill -TERM "${pid}" 2>/dev/null || true
            local i
            for i in 1 2 3 4 5; do
                pid_alive "${pid}" || break
                sleep 1
            done
            pid_alive "${pid}" && kill -KILL "${pid}" 2>/dev/null || true
            log "stopped pid ${pid} (${pf##*/})"
        fi
        rm -f "${pf}" 2>/dev/null || true
    done

    # 守护进程被 TERM 时，它前台正在跑的那个 refresh 子进程不会跟着死，所以要单独收。
    # 否则它会拿着「本轮候选」把配置覆盖回去 —— 例如刚拉取的新订阅会被盖掉。
    cfopt_reap_children

    # 清理残留内核进程。
    #
    # ⚠️ 不能用 `pkill -f "${APP_DIR}/mihomo"`：-f 是【对整条命令行做子串匹配】，
    #    凡是命令行里含该路径的进程都会被命中 —— 包括调用本脚本的 shell、
    #    调试用的 bash、以及任何命令行里恰好带上该路径的无关进程。
    #    实测已把自己所在的外层 shell 一起 SIGTERM 掉。
    #    改为按 /proc/<pid>/exe 精确比对：只杀真正由本应用内核二进制启动的进程，
    #    且显式排除自身与父进程。
    local exe target
    target="$(readlink -f "${MIHOMO_BIN}" 2>/dev/null || printf '%s' "${MIHOMO_BIN}")"
    for p in /proc/[0-9]*; do
        pid="${p#/proc/}"
        [ "${pid}" = "$$" ] && continue
        [ "${pid}" = "${PPID}" ] && continue
        exe="$(readlink -f "${p}/exe" 2>/dev/null)" || continue
        [ "${exe}" = "${target}" ] || continue
        kill -TERM "${pid}" 2>/dev/null || true
        log "reaped stray core pid ${pid}"
    done
    rm -f "${APP_DIR}/app.sock" 2>/dev/null || true
    log "stop complete"
}

case "${1:-start}" in
    start)
        # 守护进程可能因崩溃 / kill -9 / 被框架杀掉而没走 stop，留下孤儿 refresh
        # 子进程。必须在这里先收掉：否则它会在 start_ui 的健康检查（最多 10s）
        # 期间换盘，盖掉刚拉取的订阅或刚注入的配置。
        cfopt_reap_children
        # geo 数据预置放在最前：即使内核判定"已在运行"提前返回，也保证数据就位。
        # 该函数幂等（大小一致则跳过），重复执行无副作用。
        seed_geodata
        start_core
        start_ui
        # 再补一次注入：start_core 在「内核已在运行」时会提前返回，
        # 那条路径下没有走上面的注入逻辑。内容无变化时这里会自动跳过，开销可忽略。
        cfopt_apply || log "WARN cfopt: 刷新优选 IP 失败，继续使用现有配置"
        # 定时刷新守护进程放在最后：它调用 cfopt-refresh 时会先看内核是否在跑，
        # 内核已就绪时才能真正热重载配置。
        cfopt_loop_start
        ;;
    stop)
        stop_all
        ;;
    cfopt-refresh)
        # 内部命令：拉取一次 → 注入 → 校验 → 换盘 → 热重载。
        # 供刷新守护进程按间隔调用；也可以手动执行来立刻刷新。
        cfopt_apply
        ;;
    cfopt-scan)
        # 手动命令：扫出「哪些站点其实套了 Cloudflare」，供用户挑进域名清单。
        # 只读分析，不写配置、不触发注入 —— 所以不接进自动刷新链路。
        # 用法：cmd/main cfopt-scan [额外域名,逗号分隔]
        [ -f "${CFOPT_PY}" ] || { log "WARN cfopt: 找不到 ${CFOPT_PY}"; exit 1; }
        /usr/bin/python3 "${CFOPT_PY}" scan "${CFOPT_SNIPPET}" "${DATA_DIR}/cfopt-scan.txt" \
            "${2:-}" >> "${LOG_FILE}" 2>&1
        rc=$?
        if [ "${rc}" -eq 0 ]; then
            log "cfopt: 扫描结果已写入 ${DATA_DIR}/cfopt-scan.txt"
            cat "${DATA_DIR}/cfopt-scan.txt" >> "${LOG_FILE}" 2>&1
        else
            log "WARN cfopt: 扫描失败（rc=${rc}），详见日志"
        fi
        exit "${rc}"
        ;;
    cfopt-daemon)
        # 内部命令：后台常驻，周期性调用 cfopt-refresh。
        # 每个周期都重新 fork 一个完整脚本进程，因此改完设置重启应用即生效。
        cfopt_daemon "${2:-${CFOPT_INTERVAL:-24}}"
        ;;
    status)
        if core_running; then
            echo "running (mixed=${MIXED_PORT} api=${API_PORT} ui=${UI_PORT})"
            exit 0
        fi
        echo "stopped"
        exit 3          # 官方约定：3 = 未运行
        ;;
    *)
        fail "未知命令: $1（支持 start|stop|status）"
        ;;
esac
