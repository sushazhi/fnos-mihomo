appname               = mihomo
version = 1.0.6
display_name          = Mihomo
desc                  = Mihomo（Clash Meta）代理内核 fnOS 原生应用：开机自启，混合代理端口 + Clash API + 内置控制面板。
platform                   = all
source                = thirdparty

maintainer            = MetaCubeX
maintainer_url        = https://github.com/MetaCubeX/mihomo
distributor           = yukihana
distributor_url       = https://github.com/sushazhi/mihomo-fnos

os_min_version        = 1.1.3100     # 统一网关要求（官方 Native 案例说明）

desktop_uidir         = ui
desktop_applaunchname = mihomo.main

# 状态页走统一网关（Unix Socket），官方说明「通过 Socket 转发请求，因此不需要声明 service_port」。
# 仍保留 service_port 会触发 fnOS 的端口预检，而网关模式并不占用它 —— 故关闭检查。
checkport             = false
ctl_stop              = true
disable_authorization_path = true

changelog             = 首个版本：Mihomo 内核 + 内置控制面板，支持订阅、节点切换与流量监控。
